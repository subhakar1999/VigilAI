# Copy this file to .env and replace every example value before starting VigilAI.
VIGILAI_ADMIN_USERNAME=admin
VIGILAI_ADMIN_PASSWORD=replace-with-a-long-unique-password
VIGILAI_AUTH_SECRET=replace-with-at-least-32-random-characters
# Use an independent random token, at least 32 characters, distinct from the session-signing secret.
VIGILAI_API_TOKEN=replace-with-an-independent-random-token
# Explicitly add authorized agent hostnames for discovery and testing.
VIGILAI_ALLOWED_AGENT_HOSTS=localhost,127.0.0.1,::1,host.docker.internal,test-agents
# Set true only when the console is served over HTTPS.
VIGILAI_COOKIE_SECURE=false
# Required for non-local access: the exact browser origin, e.g. https://app.example.com.
# VIGILAI_PUBLIC_ORIGIN=https://app.example.com
